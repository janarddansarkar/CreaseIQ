
# LangSmith tracing (optional). Sends prompts/responses to LangSmith - leave false to stay local.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=CreaseIQ
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com   # only if your account is in the EU region

# Local Ollama model used during development (no API key needed; run `ollama serve`)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b

# Sarvam AI API - commented out for now (backend only; never expose to the frontend). Also uncomment the Sarvam lines in the notebook.
# SARVAM_API_KEY=
# SARVAM_BASE_URL=https://api.sarvam.ai/v2
# SARVAM_MODEL=sarvam-105b
